#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        macro_0: macro_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp I>
                , <&macro_release &kp LCTRL>
                , <&macro_wait_time 100>
                , <&macro_tap &kp I>
                , <&macro_wait_time 100>
                , <&macro_tap &kp D>
                , <&macro_wait_time 100>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp I>
                , <&macro_release &kp LCTRL>
                , <&macro_wait_time 100>
                , <&macro_tap &kp DOT>;
        };
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp SQT>
                , <&macro_release &kp LCTRL>
                , <&macro_wait_time 100>
                , <&macro_press &kp LCTRL>
                , <&macro_tap &kp SQT>
                , <&macro_release &kp LCTRL>;
        };
    };

    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp TAB>;
        };
        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp MINUS>, <&kp EQUAL>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &td0 &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &mt RIGHT_GUI SEMICOLON &mt DEL SQT
                &kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &mt RIGHT_SHIFT ENTER
                &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &trans &tog 1 &kp SPACE &none &tog 2 &kp LEFT &kp DOWN &kp UP &kp RIGHT
            >;
        };

        lower_layer {
            bindings = <
                &kp ESCAPE &kp EXCL &kp AT &kp LBRC &kp RBRC &kp PIPE &kp C_VOLUME_UP &kp N7 &kp N8 &kp N9 &kp KP_ASTERISK &trans
                &trans &kp HASH &kp DLLR &kp LPAR &kp RPAR &kp BACKSLASH &mt C_MUTE C_VOL_DN &kp N4 &kp N5 &kp N6 &kp KP_PLUS &trans
                &trans &kp COMMA &kp CARET &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp TILDE &kp AMPS &kp N1 &kp N2 &kp N3 &kp KP_SLASH &trans
                &trans &trans &trans &kp PRCNT &trans &trans &none &kp N0 &kp KP_DOT &kp KP_EQUAL &td1 &trans
            >;
        };

        raise_layer {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &to 4 &trans &trans &none &trans &kp HOME &kp PAGE_DOWN &kp PAGE_UP &kp END
            >;
        };

        adjust_layer {
            bindings = <
                &trans &trans &kp LC(W) &kp LC(LSFT(E)) &trans &kp LA(LC(T)) &trans &kp LC(LSFT(W)) &macro_0 &kp LA(LC(O)) &kp LC(LSFT(P)) &trans
                &kp DEL &kp LC(LSFT(A)) &kp LC(LSFT(S)) &kp LA(LC(D)) &kp LA(LC(F)) &trans &kp LA(LC(H)) &trans &trans &kp LC(LSFT(L)) &trans &trans
                &trans &trans &kp LA(LC(X)) &trans &kp LC(LSFT(V)) &kp LC(LSFT(F5)) &kp LC(LSFT(N)) &trans &trans &kp LC(LSFT(DOT)) &trans &macro_1
                &trans &trans &trans &trans &trans &trans &none &trans &kp HOME &kp PG_DN &kp PG_UP &kp END
            >;
        };

        layer_4 {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &kp LEFT_SHIFT &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &kp LEFT_CONTROL &kp LEFT_ALT &trans &to 0 &trans &trans &none &trans &trans &trans &trans &trans
            >;
        };
    };
};
